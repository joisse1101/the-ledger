# One place to see every port this project uses. Copy to `.env` (gitignored) and edit as needed.
#
# The gateway (gateway/Start-Gateway.ps1, gateway/docker-compose.yml) reads this file directly and
# uses these three values to configure itself and the Nginx proxy targets.
#
# The backend and frontend are separate local processes (see CLAUDE.md's "Setup & Run") and don't
# read this file themselves - when you change BACKEND_PORT/FRONTEND_PORT here, pass the matching
# flag to each so they actually run on the port the gateway expects:
#   cd api && python server.py --port <BACKEND_PORT>
#   cd web  && npm run preview -- --port <FRONTEND_PORT>

# Port the backend (python server.py) listens on. Default: 8501.
BACKEND_PORT=8501

# Port the frontend (vite preview) listens on. Default: 4173.
FRONTEND_PORT=4173

# Port the gateway container is published on - this is what you open in a browser
# (http://localhost:<GATEWAY_PORT>) or share with another device on the LAN. Default: 8080.
# Must not be one of Chromium's restricted ports (e.g. 10080) - browsers refuse to even attempt
# a connection to those with ERR_UNSAFE_PORT, no error visible server-side.
GATEWAY_PORT=8080
