{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist/ui",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/renderer",
    "src/shared/types.ts"
  ]
}
